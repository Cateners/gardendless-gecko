{
  "manifest_version": 2,
  "name": "GameInputFix",
  "version": "1.4",
  "browser_specific_settings": {
    "gecko": {
      "id": "gamefix@fct.com"
    }
  },
  "content_scripts": [{
    "matches": [
      "http://127.0.0.1/*",
      "http://127.0.0.1:23337/*",
      "http://localhost/*"
    ],
    "js": ["bridgePatch.js", "touchPatch.js"],
    "run_at": "document_end"
  }]
}
